{
  "expo": {
    "name": "FahmiFit",
    "slug": "fahmifit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1117"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fahmifit.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FahmiFit needs camera access to scan meals and barcodes.",
        "NSPhotoLibraryUsageDescription": "FahmiFit needs photo library access to analyze meal photos.",
        "NSPhotoLibraryAddUsageDescription": "FahmiFit needs to save photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1117"
      },
      "package": "com.fahmifit.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FahmiFit to access your camera to scan meals."
        }
      ],
      [
        "expo-barcode-scanner",
        {
          "cameraPermission": "Allow FahmiFit to access camera for barcode scanning."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FahmiFit to access your photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#22c55e"
        }
      ]
    ],
    "scheme": "fahmifit",
    "extra": {
      "eas": {
        "projectId": "fahmifit-app"
      }
    }
  }
}
